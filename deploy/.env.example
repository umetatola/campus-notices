# Production settings. Copy to .env on the server (never commit .env).

# Web address, without https://, e.g. campusnotices.duckdns.org
DOMAIN=

# Free domain from duckdns.org (optional): the bootstrap script keeps it pointed at this server.
# DUCKDNS_SUBDOMAIN is the part before .duckdns.org; the token is shown on duckdns.org after signing in.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# Database password: any long random string (bootstrap.sh fills this in for you)
DB_PASSWORD=

# Outgoing email. With Gmail: an app password (Google account > Security > 2-Step Verification > App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Campus Notices <your-address@gmail.com>

# Optional: English summaries (without it, notices wait in the summary queue)
ANTHROPIC_API_KEY=
