# Production settings. Copy to .env on the server (never commit .env).

# Web address, without https://, e.g. campus-notices.duckdns.org
DOMAIN=

# Database password: any long random string, e.g. from: openssl rand -hex 24
DB_PASSWORD=

# Outgoing email. With Gmail: an app password (Google account > Security > 2-Step Verification > App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Campus Notices <your-address@gmail.com>

# Optional: English summaries (without it, notices wait in the summary queue)
ANTHROPIC_API_KEY=
